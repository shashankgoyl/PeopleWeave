# Read by pipeline/merge.py via python-dotenv's load_dotenv(), which looks
# in the current working directory - so this file needs to be at
# pipeline/.env (i.e. run `cp .env.example .env` from *inside* pipeline/,
# not from the repo root).

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key-not-the-anon-key
