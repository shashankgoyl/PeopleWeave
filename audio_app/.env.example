# If both of these are set, the app talks directly to Supabase (anon key -
# safe to ship to the browser, see supabase/migrations/0002_audio_app_rls.sql
# for the RLS policies that scope what it's allowed to do).
#
# If either is missing, the app falls back to a local IndexedDB store - audio
# blobs and submissions stay in the browser, nothing leaves the machine, and
# `npm run dev` just works with zero setup.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-not-the-service-role-key
